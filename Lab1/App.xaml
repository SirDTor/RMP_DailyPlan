<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Lab1"
             x:Class="Lab1.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <!--<ResourceDictionary Source="Resources/Styles/Styles.xaml" />-->
            </ResourceDictionary.MergedDictionaries>
            <!-- Цвет фона страницы -->
            <Color x:Key="BackgroundColor">White</Color>

            <!-- Цвет текста -->
            <Color x:Key="PrimaryTextColor">Black</Color>

            <Color x:Key="ButtonBackgroundColor">Yellow</Color>

            <!-- Размер шрифта -->
            <x:Double x:Key="FontSize">16</x:Double>

            <Style TargetType="Grid">
                <Setter Property="BackgroundColor" Value="{DynamicResource BackgroundColor}" />
            </Style>

            <!-- Глобальный стиль для всех Label -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
            </Style>

            <!-- Глобальный стиль для всех Button -->
            <Style TargetType="Button">
                <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
                <Setter Property="BackgroundColor" Value="{DynamicResource ButtonBackgroundColor}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
