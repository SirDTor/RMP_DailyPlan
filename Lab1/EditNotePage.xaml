<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab1.EditNotePage"
             Title="Заметка">
    <VerticalStackLayout Margin="20">
        <Entry x:Name="TitleEntry" Placeholder="Название"/>
        <Editor x:Name="ContentEditor" Placeholder="Текст заметки" HeightRequest="200"/>
        <DatePicker x:Name="DatePicker"/>
        <TimePicker x:Name="TimePicker"/>

        <HorizontalStackLayout Margin="0, 20, 0, 0">
            <Button Text="Сохранить" Clicked="OnSaveClicked" />
            <Button Text="Отмена" Clicked="OnCancelClicked" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>